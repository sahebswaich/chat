{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Nimbus server: a single Cloudflare Worker backed by one D1 database.
  "name": "nimbus",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // nodejs_compat: needed by the Anthropic SDK.
  // enable_request_signal: `request.signal` aborts when the app disconnects, so an
  // answer nobody is reading stops streaming from Claude (and stops costing tokens).
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "workers_dev": true,
  "observability": { "enabled": true },

  // Plain (non-secret) settings. Change them here and redeploy.
  "vars": {
    // Messages per user per UTC day (an invite can override it per person).
    "DAILY_LIMIT": "200",
    // Public TestFlight link shown on the /join page ("" hides the button).
    "TESTFLIGHT_URL": "",
    // Claude model used for every answer.
    "MODEL": "claude-opus-5-5"
  },

  // Set with `npx wrangler secret put <NAME>`, or with `--secrets-file` on the very
  // first deploy (see README.md). SUPPORT_EMAIL is an optional extra secret (contact
  // address shown in the app and on /support); it is deliberately not a var so a
  // value set with `wrangler secret put` is never overwritten by a deploy.
  "secrets": {
    "required": ["ANTHROPIC_API_KEY", "ADMIN_TOKEN"]
  },

  // No database_id needed: `wrangler deploy` creates the "nimbus" database on the
  // first deploy (automatic provisioning) and finds it by name afterwards.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nimbus",
      "migrations_dir": "migrations"
    }
  ]
}
